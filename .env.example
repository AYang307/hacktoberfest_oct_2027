# Optional: demo mode works with ALL values blank. Copy to .env.local to configure.
# Server-only. Never prefix any Snowflake variable with NEXT_PUBLIC_.

# Account identifier from Snowsight (organization-account; no https or domain).
SNOWFLAKE_ACCOUNT=
# Existing Snowflake user authorized to use the chosen role.
SNOWFLAKE_USERNAME=
# Existing warehouse with USAGE granted to the role.
SNOWFLAKE_WAREHOUSE=
# Role granted Cortex and AI_COMPLETE permissions; see README.
SNOWFLAKE_ROLE=
# Supported text model permitted in your account/region. Check SHOW CORTEX BASE MODELS.
SNOWFLAKE_MODEL=llama3.3-70b

# Preferred: absolute path to a PKCS#8 PEM private key kept OUTSIDE this project.
# Register its public key on the Snowflake user. Key takes priority over password.
SNOWFLAKE_PRIVATE_KEY_PATH=
# Optional passphrase if the key is encrypted.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Alternative only if your account's authentication policy permits password auth.
SNOWFLAKE_PASSWORD=
